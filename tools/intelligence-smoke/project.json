{
  "name": "intelligence-smoke",
  "root": "tools/intelligence-smoke",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/intelligence-smoke/*.test.mjs tools/intelligence-smoke/rich-threads/*.test.mjs tools/intelligence-smoke/rich-threads/rows/*.test.mjs"
      },
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/intelligence-smoke/run.mjs"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint tools/intelligence-smoke"
      }
    },
    "rich-threads": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/intelligence-smoke/rich-threads/run.mjs"
      },
      "cache": false
    },
    "rich-threads-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/intelligence-smoke/rich-threads/*.test.mjs tools/intelligence-smoke/rich-threads/rows/*.test.mjs"
      },
      "cache": false
    },
    "rich-threads-prepare": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/intelligence-smoke/rich-threads/prepare.mjs"
      },
      "cache": false
    },
    "rich-threads-setup": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm ci --ignore-scripts --prefix tools/intelligence-smoke/rich-threads/dependencies",
          "node tools/intelligence-smoke/rich-threads/dependencies/node_modules/playwright/cli.js install chromium"
        ],
        "parallel": false
      },
      "cache": false
    },
    "rich-threads-driver-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/intelligence-smoke/rich-threads/driver.integration.mjs"
      },
      "cache": false
    },
    "rich-threads-app": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/intelligence-smoke/rich-threads/application/start.mjs"
      },
      "cache": false
    },
    "rich-threads-recover": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/intelligence-smoke/rich-threads/recover.mjs"
      },
      "cache": false
    },
    "rich-threads-browser-system-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/intelligence-smoke/rich-threads/dependencies/node_modules/playwright/cli.js install-deps chromium"
      },
      "cache": false
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt --write tools/intelligence-smoke/rich-threads tools/intelligence-smoke/project.json"
      },
      "cache": false
    }
  }
}
