{"id":"news-sources","message":"Is remote work actually more productive? Show me what the research says.","catalog":"standard","tags":["citation","links","table"],"expect":{"ui":true,"components":["Citation"]},"context":[{"description":"Results of literature_search(query=\"remote work productivity\", type=\"peer-reviewed and working papers\", sort=\"relevance\")","value":[{"title":"Hybrid working from home improves retention without damaging performance","authors":["Nicholas Bloom","Ruobing Han","James Liang"],"year":2024,"venue":"Nature","url":"https://www.nature.com/articles/s41586-024-07500-2","design":"Randomized controlled trial, 6 months","sample":"1,612 graduate employees at Trip.com in engineering, marketing and finance; 2 home days a week","key_finding":"Hybrid working reduced quit rates by one-third and did not affect performance grades or promotions over the next two years of reviews."},{"title":"Does Working from Home Work? Evidence from a Chinese Experiment","authors":["Nicholas Bloom","James Liang","John Roberts","Zhichun Jenny Ying"],"year":2015,"venue":"Quarterly Journal of Economics","url":"https://academic.oup.com/qje/article/130/1/165/2337855","design":"Randomized controlled trial, 9 months","sample":"Call centre volunteers at a Chinese travel agency; 4 home days a week","key_finding":"Home working led to a 13% performance increase, mostly from more minutes worked per shift (fewer breaks and sick days)."},{"title":"Working Remotely? Selection, Treatment, and the Market for Remote Work","authors":["Natalia Emanuel","Emma Harrington"],"year":2024,"venue":"American Economic Journal: Applied Economics","url":"https://www.aeaweb.org/articles?id=10.1257/app.20230376","design":"Natural experiment","sample":"Call centre workers at a US Fortune 500 firm; fully remote","key_finding":"Remote workers answered 12% fewer calls per hour; about 4 percentage points were caused by working remotely, the rest came from who chose remote jobs."},{"title":"Work from Home and Productivity: Evidence from Personnel and Analytics Data on Information Technology Professionals","authors":["Michael Gibbs","Friederike Mengel","Christoph Siemroth"],"year":2023,"venue":"Journal of Political Economy Microeconomics","url":"https://www.journals.uchicago.edu/doi/10.1086/721803","design":"Before and after (pandemic shift)","sample":"10,000+ staff at an IT services firm in India; fully remote","key_finding":"Hours worked increased by about 30%, output declined slightly, and productivity fell 8%–19%."},{"title":"Work-from-anywhere: The productivity effects of geographic flexibility","authors":["Prithwiraj Choudhury","Cirrus Foroughi","Barbara Larson"],"year":2021,"venue":"Strategic Management Journal","url":"https://onlinelibrary.wiley.com/doi/10.1002/smj.3251","design":"Natural experiment","sample":"US Patent and Trademark Office examiners","key_finding":"Moving from work-from-home to work-from-anywhere raised patent examiners' output by 4.4%."},{"title":"The effects of remote work on collaboration among information workers","authors":["Longqi Yang","David Holtz","Sonia Jaffe","et al."],"year":2022,"venue":"Nature Human Behaviour","url":"https://www.nature.com/articles/s41562-021-01196-4","design":"Observational, firm-wide shift in 2020","sample":"61,182 US Microsoft employees","key_finding":"Firm-wide remote work caused the collaboration network to become more static and siloed, with fewer bridging ties across groups and a shift from synchronous to asynchronous communication (email, chat)."},{"title":"The Power of Proximity to Coworkers: Training for Tomorrow or Productivity Today?","authors":["Natalia Emanuel","Emma Harrington","Amanda Pallais"],"year":2023,"venue":"NBER Working Paper 31880","url":"https://www.nber.org/papers/w31880","design":"Natural experiment","sample":"Software engineers at a Fortune 500 firm","key_finding":"Sitting near teammates increases coding feedback by 18.3% and improves code quality; gains are largest for newer engineers, while senior engineers write less code themselves."},{"title":"Working from Home, Worker Sorting and Development","authors":["David Atkin","Antoinette Schoar","Sumit Shinde"],"year":2023,"venue":"NBER Working Paper 31515","url":"https://www.nber.org/papers/w31515","design":"Randomized controlled trial","sample":"Data-entry workers in India","key_finding":"Workers assigned to home were 18% less productive than those in the office."},{"title":"Why Working from Home Will Stick","authors":["Jose Maria Barrero","Nicholas Bloom","Steven J. Davis"],"year":2021,"venue":"NBER Working Paper 28731","url":"https://www.nber.org/papers/w28731","design":"Survey","sample":"30,000+ US workers","key_finding":"Most workers report being as or more productive at home than expected; the authors project a lasting shift to hybrid work."}]}]}
