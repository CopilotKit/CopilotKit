{
  "name": "repo-scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "scripts",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["@copilotkit/runtime", "@copilotkit/learning"],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          "pnpm exec vitest run scripts/__tests__/agentcore-deploy-skip-backend.test.ts scripts/__tests__/agentcore-runtime-security.test.ts scripts/__tests__/lint-baseline.test.ts scripts/__tests__/lint-gate.test.ts scripts/__tests__/runtime-entitlement-recovery.test.ts scripts/__tests__/telemetry-fragment.test.ts scripts/__tests__/validate-integration-pins.test.ts scripts/doc-tests/__tests__/extract.test.ts codemods/__tests__/",
          "node --test scripts/deprecations/v1-dist-notices.test.mjs",
          "bash scripts/release/__tests__/detect-py-version-changes.test.sh"
        ],
        "parallel": false
      }
    },
    "validate-production-verification": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/__tests__/showcase-promote-workflow.test.mjs scripts/__tests__/showcase-build-impact.test.mjs"
      }
    },
    "validate-starter-deps": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test scripts/__tests__/validate-starter-deps.test.mjs",
          "node scripts/validate-starter-deps.mjs"
        ],
        "parallel": false
      }
    },
    "validate-channels-zod": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test scripts/__tests__/validate-channels-zod.test.mjs",
          "node scripts/validate-channels-zod.mjs"
        ],
        "parallel": false
      }
    },
    "validate-retired-anthropic-models": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test scripts/__tests__/validate-retired-anthropic-models.test.mjs",
          "node scripts/validate-retired-anthropic-models.mjs"
        ],
        "parallel": false
      }
    },
    "validate-docs-deprecated-imports": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node --test scripts/__tests__/validate-docs-deprecated-imports.test.mjs",
          "node scripts/validate-docs-deprecated-imports.mjs"
        ],
        "parallel": false
      }
    },
    "check-docs-snippets": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "kiira check",
        "cwd": "{workspaceRoot}"
      }
    },
    "validate-examples-catalog": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/__tests__/examples-readme-catalog.test.mjs"
      }
    }
  },
  "tags": []
}
