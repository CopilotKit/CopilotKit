# Copy to .env. Next.js reads this file; the agent reads it too (and also
# agent/.env if you prefer to keep the model key there).

# ── Agent (Python, agent/) ──────────────────────────────────────────────
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id. gemini-3.8-flash is the SDK's own default.
# gemini-3.5-flash-lite is a cheaper option.
GEMINI_MODEL=gemini-3.5-flash
# Optional: how much the model reasons before answering: minimal, low, medium
# or high. Unset keeps the SDK and model default. Lower is cheaper and faster.
# GEMINI_THINKING_LEVEL=low
# Optional: send Gemini requests to a gateway instead of Google. Leave blank
# for normal use. (The e2e tests point it at their scripted model; see README.)
GOOGLE_GEMINI_BASE_URL=
# Where the harness works. Keep these short: the model copies absolute paths
# into tool calls and mangles long ones.
WORKSPACE_ROOT=/tmp/rd/ws
SAVE_DIR=/tmp/rd/sessions
PUSH_ROOT=/tmp/rd/remotes
# Each thread's Python venv; the repo's .venv links here. Keep it on local disk.
VENV_ROOT=/tmp/rd/venvs
# The agent's own uv cache (never your global one); pruned at startup and
# cleared past UV_CACHE_MAX_BYTES (default 6 GB).
UV_CACHE_DIR=/tmp/rd/uv-cache
# UV_CACHE_MAX_BYTES=6000000000
# Optional: save each conversation (repo, pushed branches, harness session) to
# Cloud Storage and restore it after a restart. gs://bucket, or file:///dir to
# try it locally. Repos over SNAPSHOT_MAX_BYTES (default 500 MB) are not saved.
WORKSPACE_BUCKET=
# SNAPSHOT_MAX_BYTES=500000000
# Optional limits.
# MAX_TOOL_CALLS_PER_TURN=60
# COMMAND_TIMEOUT_SECONDS=600

# ── GitHub (optional, both) ─────────────────────────────────────────────
# A read-only token (a fine-grained token with public repository read access
# and no other permissions is enough). Used only for GitHub API reads: the
# repository cards on the start screen and the agent's CI check. It is never
# given to the agent's shell or the cloned code. Without it everything works,
# limited to 60 GitHub API requests an hour per IP.
GITHUB_TOKEN=

# ── App (Next.js) ───────────────────────────────────────────────────────
AGENT_URL=http://127.0.0.1:8000/

# Optional: CopilotKit Intelligence (threads + Product Analytics).
# `npx copilotkit@latest project select --create repo-doctor --env-name .env`
# writes the key here.
CPK_INTELLIGENCE_API_KEY=
# Only for self-hosted Intelligence.
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=
# The user for requests made before a name is set in the navbar. Not
# authentication: replace identifyUser with real auth before a public deploy.
DEMO_USER_ID=repo-doctor-demo

# Public URL of the deployed app, for link previews (Open Graph). e.g. https://your-service.example.com
# APP_URL=
