# Obtain with: npx copilotkit@latest project select --create "Autopilot Logistics Prototype"
CPK_INTELLIGENCE_API_KEY=
# A model key with access to the configured model.
OPENAI_API_KEY=
AUTOPILOT_MODEL=gpt-5.2
# Optional absolute SQLite file path. Defaults to ./data/northstar.sqlite.
NORTHSTAR_DB_PATH=
