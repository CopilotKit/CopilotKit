# --- AWS Strands (TypeScript) starter ---

# Your OpenAI API key (required for the openai provider). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model for every model call in the agent: <provider>:<model>, provider one of
# openai, anthropic, google. Set the matching key (ANTHROPIC_API_KEY or
# GOOGLE_API_KEY) for a non-OpenAI provider. For an OpenAI-compatible
# provider use openai:<its model id> and set OPENAI_BASE_URL. (The older
# MODEL_ID=<openai model> still works when this is unset.)
COPILOTKIT_AGENT_MODEL=openai:gpt-4o
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=

# URL the Next.js runtime uses to reach the agent (optional).
AGENT_URL=http://localhost:8000

# --- CopilotKit Intelligence (optional) ---
# Set CPK_INTELLIGENCE_API_KEY to activate live thread history.
# COPILOTKIT_LICENSE_TOKEN= # self-hosted/offline only
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=
