{
  "name": "channels-a2ui-example",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "uv run --project agent python agent/main.py",
    "channel": "tsx channel/index.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test-agent": "uv run --project agent python -m unittest discover -s agent -p 'test_*.py'"
  },
  "dependencies": {
    "@copilotkit/channels": "workspace:*",
    "@copilotkit/runtime": "workspace:*",
    "dotenv": "^16.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3"
  }
}
