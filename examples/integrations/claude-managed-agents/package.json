{
  "name": "claude-managed-agents-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "agent:plan": "node scripts/ant.mjs apply --dry-run anthropic",
    "agent:apply": "node scripts/ant.mjs apply --yes anthropic",
    "doctor": "node scripts/doctor.mjs",
    "dev:mock": "node scripts/mock.mjs dev",
    "mock:record": "node scripts/mock.mjs record",
    "test": "tsx --test tests/*.test.ts",
    "lint": "oxlint app lib scripts tests",
    "test:e2e": "playwright test",
    "test:live-skills": "tsx tests/native-skills.live.ts"
  },
  "dependencies": {
    "@ag-ui/claude-managed-agents": "0.0.1",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@anthropic-ai/sdk": "0.129.0",
    "@copilotkit/react-core": "1.78.0",
    "@copilotkit/runtime": "1.78.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource-variable/spline-sans-mono": "^5.2.8",
    "@next/env": "16.1.6",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@copilotkit/aimock": "1.43.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "^0.8.2",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@ag-ui/proto": "1.0.2"
  },
  "pnpm": {
    "overrides": {
      "@ag-ui/client": "1.0.2",
      "@ag-ui/core": "1.0.2",
      "@ag-ui/encoder": "1.0.2",
      "@ag-ui/proto": "1.0.2"
    }
  }
}
