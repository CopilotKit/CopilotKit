# --- Required ---------------------------------------------------------------
# The Antigravity harness calls Gemini, and GEMINI_API_KEY is the only name
# the SDK reads (an ADK-style GOOGLE_API_KEY is not picked up). Get one at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=...

# --- Optional ---------------------------------------------------------------
# A Gemini-compatible server to call instead of Google's API, such as a gateway
# or aimock. The harness still needs GEMINI_API_KEY set; a mock ignores it.
# GOOGLE_GEMINI_BASE_URL=http://localhost:4010

# Model the harness asks for on every turn. Defaults to the SDK's default
# Gemini model.
# ANTIGRAVITY_MODEL=

# The sandbox the Go harness does its real file and shell work in, and where it
# writes session trajectories. Keep the WORKSPACE path SHORT — a long,
# high-entropy path makes the model reproduce it wrongly inside tool calls and
# the run dies mid-call. Defaults to /data/ws and /data/sessions inside the
# container, and to /tmp/agws and /tmp/agsess outside it.
# ANTIGRAVITY_WORKSPACE=/tmp/agws
# ANTIGRAVITY_SAVE_DIR=/tmp/agsess

# Where the Next.js runtime route reaches the Python agent.
AGENT_URL=http://localhost:8000

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL and INTELLIGENCE_GATEWAY_WS_URL point at a self-hosted
# or local Intelligence deployment only — leave them unset when using managed
# Intelligence, or the channel host and runtime will try to reach a local
# stack that usually is not running.
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=
