    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "hono": "^4",
    "next": "16.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
