OPENAI_API_KEY=your-api-key-here
AGENT_URL=http://localhost:8000

# Model for the agent: <provider>:<model>, provider one of openai, anthropic,
# google. Set the matching key (ANTHROPIC_API_KEY or GOOGLE_API_KEY) for a
# non-OpenAI provider. For an OpenAI-compatible provider use
# openai:<its model id> and set OPENAI_BASE_URL. Overrides
# OPENAI_CHAT_MODEL_ID. Ignored when AZURE_OPENAI_ENDPOINT is set (Azure uses
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME).
COPILOTKIT_AGENT_MODEL=openai:gpt-4o-mini
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL and INTELLIGENCE_GATEWAY_WS_URL point at a self-hosted
# or local Intelligence deployment only — leave them unset when using managed
# Intelligence, or the channel host and runtime will try to reach a local
# stack that usually is not running.
# INTELLIGENCE_API_URL=http://localhost:4205
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4405
# CPK_INTELLIGENCE_API_KEY=
