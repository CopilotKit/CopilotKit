OPENAI_API_KEY=your-api-key-here
AGENT_URL=http://localhost:8000

# Model for every model call in the agent: <provider>:<model>, provider one of
# openai, anthropic, google. Set the matching key (ANTHROPIC_API_KEY or
# GOOGLE_API_KEY) for a non-OpenAI provider. For an OpenAI-compatible
# provider use openai:<its model id> and set OPENAI_BASE_URL.
COPILOTKIT_AGENT_MODEL=openai:gpt-5-mini
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=

# --- copilotkit:intelligence (optional local threads stack) ---
# COPILOTKIT_LICENSE_TOKEN=
# CPK_INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL and INTELLIGENCE_GATEWAY_WS_URL point at a self-hosted
# or local Intelligence deployment only — leave them unset when using managed
# Intelligence, or the channel host and runtime will try to reach a local
# stack that usually is not running.
# INTELLIGENCE_API_URL=http://localhost:4206
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4406
