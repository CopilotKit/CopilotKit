# Dockerfile for the agent: the Cloudflare Worker in agent/, run on workerd by
# `wrangler dev` with a local Durable Object store, as `npm run dev` does.
# workerd needs glibc, hence the Debian base rather than Alpine.
FROM node:22-slim

# ca-certificates: workerd verifies TLS when OPENAI_BASE_URL is a real provider.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies (wrangler brings workerd)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy the Worker
COPY tsconfig.json wrangler.jsonc ./
COPY src/ ./src/

# Keep the Worker's TypeScript checked by starter CI.
RUN npm run typecheck

EXPOSE 8000

# CLOUDFLARE_INCLUDE_PROCESS_ENV hands the container environment
# (OPENAI_API_KEY, OPENAI_BASE_URL, COPILOTKIT_AGENT_MODEL) to the Worker as
# bindings. CI and WRANGLER_SEND_METRICS keep wrangler non-interactive and
# offline.
ENV CLOUDFLARE_INCLUDE_PROCESS_ENV=true CI=true WRANGLER_SEND_METRICS=false

CMD ["npx", "wrangler", "dev", "--ip", "0.0.0.0", "--port", "8000", "--show-interactive-dev-session=false"]
