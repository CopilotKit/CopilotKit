# --- Cloudflare Agents starter ---
# `npm run dev` hands these to the Worker in agent/ (wrangler dev --env-file)
# and to the Next.js app.

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model for every model call in the agent: openai:<model>. For an
# OpenAI-compatible provider use openai:<its model id>, set OPENAI_BASE_URL,
# and put that provider's key in OPENAI_API_KEY.
COPILOTKIT_AGENT_MODEL=openai:gpt-6-luna
# OPENAI_BASE_URL=

# URL the Next.js runtime uses to reach the Worker (optional). Point it at a
# deployed Worker, e.g. https://copilotkit-cloudflare-agents-starter.<your-subdomain>.workers.dev
AGENT_URL=http://localhost:8000

# --- CopilotKit Intelligence (optional) ---
# Set CPK_INTELLIGENCE_API_KEY to activate live thread history.
# COPILOTKIT_LICENSE_TOKEN= # self-hosted/offline only
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=
