# The C# agent reads OPENAI_API_KEY from .NET user-secrets; see README.md.
AGENT_URL=http://localhost:8000

# Model for the agent: <provider>:<model>, provider one of openai, anthropic,
# google (with ANTHROPIC_API_KEY or GOOGLE_API_KEY for a non-OpenAI provider;
# openai:<its model id> plus OPENAI_BASE_URL for an OpenAI-compatible one).
# Like OPENAI_API_KEY, the C# agent reads this from .NET configuration, not
# from this file: export it, or run
#   dotnet user-secrets set COPILOTKIT_AGENT_MODEL "openai:gpt-5-mini"
COPILOTKIT_AGENT_MODEL=openai:gpt-5-mini

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL and INTELLIGENCE_GATEWAY_WS_URL point at a self-hosted
# or local Intelligence deployment only — leave them unset when using managed
# Intelligence, or the channel host and runtime will try to reach a local
# stack that usually is not running.
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=
