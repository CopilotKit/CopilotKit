{
  "name": "starter-claude-managed-agents-flutter",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:examples"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/claude-managed-agents-flutter",
        "command": "npm test"
      },
      "dependsOn": []
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/claude-managed-agents-flutter",
        "command": "npm run typecheck"
      },
      "dependsOn": []
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/claude-managed-agents-flutter",
        "command": "npm run lint"
      },
      "dependsOn": []
    },
    "flutter-analyze": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/claude-managed-agents-flutter/flutter",
        "command": "flutter analyze"
      },
      "dependsOn": []
    },
    "flutter-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/claude-managed-agents-flutter/flutter",
        "command": "flutter test"
      },
      "dependsOn": []
    }
  },
  "implicitDependencies": ["!@copilotkit/*"]
}
