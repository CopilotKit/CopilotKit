# --- AWS Strands (TypeScript) starter ---

# Your OpenAI API key (required). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model used by the Strands agent (optional).
MODEL_ID=gpt-4o

# URL the Next.js runtime uses to reach the agent (optional).
AGENT_URL=http://localhost:8000

# --- CopilotKit Intelligence (optional) ---
# Set COPILOTKIT_LICENSE_TOKEN to activate live thread history.
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=
