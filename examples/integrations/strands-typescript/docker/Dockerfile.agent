# Dockerfile for the AWS Strands (TypeScript) agent.
# Mirrors the local dev experience: npm install + tsx.
FROM node:22-slim

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm install

# Copy agent source
COPY tsconfig.json ./
COPY src/ ./src/

EXPOSE 8000

CMD ["npx", "tsx", "src/server.ts"]
