# Omnara, server-only. Create a personal token at https://app.omnara.com
# (account menu > Personal tokens), then run `npm run doctor` to list your org
# and project IDs.
OMNARA_API_KEY=
OMNARA_ORG_ID=
OMNARA_PROJECT_ID=
# Optional profile name or ID; defaults to the one `npm run agent:apply` creates.
# OMNARA_PROFILE=copilotkit-assistant
# Self-hosted Omnara serves its API at https://<your-host>/api/v1.
# OMNARA_API_URL=

# `npx copilotkit@latest project select` fills this in.
CPK_INTELLIGENCE_API_KEY=
# Defaults point to managed Intelligence. Set both for self-hosting.
# INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
# INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai

# Explicit mock/alternate AG-UI endpoint; bypasses Omnara and Intelligence:
# AGENT_URL=http://127.0.0.1:4010
