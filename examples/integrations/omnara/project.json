{
  "name": "starter-omnara",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:examples"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/omnara",
        "command": "npm run build"
      },
      "dependsOn": []
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/omnara",
        "command": "npm run typecheck && npm run typecheck:channel"
      },
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/omnara",
        "command": "npm run test"
      },
      "dependsOn": []
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/omnara",
        "command": "npm run lint"
      },
      "dependsOn": []
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/integrations/omnara",
        "command": "npm run test:e2e"
      },
      "dependsOn": []
    }
  },
  "implicitDependencies": ["!@copilotkit/*"]
}
