# Required. Gemini API key from https://aistudio.google.com/apikey (the agent
# reads it). With only this key the desk is stateless: anyone can use it,
# nothing is kept, and there is no sign-in.
GEMINI_API_KEY=
# Optional, all three together. With Clerk's two keys
# (https://dashboard.clerk.com → API keys) and the Intelligence key
# (`npx copilotkit@latest project select` writes it), the desk is stateful:
# readers sign in, keep their threads and connect apps. Missing any one, it
# stays stateless. Restart the app after changing them.
# On a hosted build (e.g. Railway/Docker), VITE_CLERK_PUBLISHABLE_KEY must be
# present when the app is built: it is inlined into the client bundle then.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CPK_INTELLIGENCE_API_KEY=
# Optional. Composio project key (https://platform.composio.dev → Settings).
# Needs the stateful desk. Without it the Connections page is off and the agent does
# research only.
COMPOSIO_API_KEY=
# Optional. Where the ADK agent serves AG-UI (default http://localhost:8014/)
AGENT_URL=http://localhost:8014/
# Optional. When set, the agent trusts the reader the runtime names only if
# the runtime also sends this secret. Set it wherever the agent is reachable
# by anything but the app's server.
AGENT_SHARED_SECRET=
