# Gemini API key from https://aistudio.google.com/apikey (the agent reads it)
GEMINI_API_KEY=
# CopilotKit Intelligence project key: `npx copilotkit@latest project select` writes it
CPK_INTELLIGENCE_API_KEY=
# Clerk application keys (https://dashboard.clerk.com → API keys). Sign-in is
# required; each reader gets their own threads.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Composio project key (https://platform.composio.dev → Settings). Optional:
# without it the Connections page is off and the agent does research only.
COMPOSIO_API_KEY=
# Where the ADK agent serves AG-UI
AGENT_URL=http://localhost:8014/
# Optional. When set, the agent trusts the reader the runtime names only if
# the runtime also sends this secret. Set it wherever the agent is reachable
# by anything but the app's server.
AGENT_SHARED_SECRET=
