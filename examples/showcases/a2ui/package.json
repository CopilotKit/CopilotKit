    "@copilotkit/runtime": "workspace:*",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "lucide-react": "0.525.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.44",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
