{
  "name": "@copilotkit/example-a2ui-research-desk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "example-dev": "vite dev --port 3014",
    "example-build": "vite build",
    "example-start": "node .output/server/index.mjs",
