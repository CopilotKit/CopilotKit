  "/skills": [
    {
      "name": "approve-team-event-expense",
      "status": "candidate",
      "description": "Use when approving an expense report blocked by POLICY_HOLD POL-114 (team events over $2,500): allocate CC-410 Events & Offsites, then approve and reimburse.",
      "skillMd": "---\nname: approve-team-event-expense\ndescription: Use when approving an expense report blocked by POLICY_HOLD POL-114 (team events over $2,500).\n---\n# Approve a team-event expense report\n\nTeam events over $2,500 must be allocated to an events cost center before approval (policy POL-114).\n\n## Steps\n1. Call `getReport` and confirm the category is \"Team event\" and the total is over $2,500.\n2. If there is no cost center, call `allocateCostCenter` with `CC-410` (Events & Offsites).\n3. Call `approveReport` once.\n4. If the user asked for reimbursement, call `reimburseReport` once.\n\n## Do not\n- Retry `approveReport` while POL-114 is unmet.\n- Tell the user to approve the report by hand.\n",
      "supportingInsightIds": [
        "ins_01",
        "ins_02"
      ],
      "revision": 1
    }
  ],
