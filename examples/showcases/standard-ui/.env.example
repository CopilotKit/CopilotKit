# Required: the built-in agent's model key.
OPENAI_API_KEY=

# Optional: model for the built-in agent (provider/model). Default: openai/gpt-5.6-sol.
# COPILOTKIT_MODEL=openai/gpt-5.6-sol
# Optional: OpenAI reasoning effort (none | low | medium | high). Default: low.
# OPENAI_REASONING_EFFORT=low

# Optional: public-hosting limits (see app/lib/limits.ts).
# AGENT_RUNS_PER_10_MIN=12   # per visitor, after a burst of 6
# AGENT_RUNS_PER_HOUR=300    # across every visitor
# AGENT_RUNS_PER_DAY=1000    # across every visitor, per UTC day
# AGENT_RUNS_PAUSED=1        # kill switch: refuse every live run
