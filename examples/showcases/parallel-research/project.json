{
  "name": "parallel-research",
  "projectType": "application",
  "tags": [
    "scope:examples"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/showcases/parallel-research",
        "command": "npm run build"
      },
      "dependsOn": []
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/showcases/parallel-research",
        "command": "npm run typecheck"
      },
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/showcases/parallel-research",
        "command": "npm run test"
      },
      "dependsOn": []
    }
  },
  "implicitDependencies": [
    "!@copilotkit/*"
  ]
}
