# Gemini Flash is the default model (Google AI Studio key).
GEMINI_API_KEY=
# GPT, from the model picker.
# OPENAI_API_KEY=
# Gemma 4 from the model picker runs on any OpenAI-compatible server; Ollama by default:
#   ollama pull gemma4:e4b
# A hosted server has no local Ollama, so there Gemma needs GEMMA_BASE_URL. The Gemini API
# serves Gemma 4 too, on the same key:
#   GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   GEMMA_API_KEY=<your Gemini key>
#   GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma4:e4b

# The public repo behind "Get the code". Unset, the site hides repo links and points to the docs.
# NEXT_PUBLIC_REPO_URL=https://github.com/<org>/a2ui-playground

# The /adk page talks to the Python agent in examples/adk.
# ADK_AGENT_URL=http://localhost:8000/

# The /jev pages call Jev live; saved runs replay without a key.
# TYPESAFE_API_KEY=

# Optional overrides
# A2UI_GEMINI_MODEL=gemini-flash-latest
# A2UI_ROUTER_MODEL=gpt-5.5
# A2UI_COMPOSER_MODEL=gpt-5.4-mini

# Hosting (see "Hosting" in the README). In production the demo pages and routes answer 404 unless opted in.
# AGENT_RUNS_PER_10_MIN=12            # agent runs per visitor per 10 minutes, after a burst of 6
# ENABLE_MINIMAL=1                    # /minimal and /api/minimal (gpt-5.5 on OPENAI_API_KEY)
# ENABLE_JEV=1                        # /jev*, /api/jev and /api/jev-chat (TYPESAFE_API_KEY)
# ENABLE_ADK=1                        # /adk and /api/adk (proxies to ADK_AGENT_URL)
# ENABLE_SNAPSHOT=1                   # /snapshot, the screenshot utility
# DISABLED_MODELS=gpt                 # turn models off without removing their keys (comma-separated ids)
# COPILOTKIT_TELEMETRY_DISABLED=true  # turns off the CopilotKit runtime's usage telemetry (DO_NOT_TRACK=1 also works)
