# --- Required ---------------------------------------------------------------
# The Antigravity harness calls Gemini. GEMINI_API_KEY is the only name the SDK
# reads. Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# --- Optional ---------------------------------------------------------------
# The default model, used when the page asks for none. Defaults to the
# Antigravity SDK's default (gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# The models the page's model picker may ask for, comma-separated. Keep it in
# step with src/lib/models.ts.
# GEMINI_MODELS=gemini-3.8-flash,gemini-4-neon,gemini-3.1-pro-preview

# minimal, low, medium or high. Defaults to low: the canvas arrives in one tool
# call, so every second of thinking is a second of an empty canvas.
# GEMINI_THINKING_LEVEL=low

# A Gemini-compatible server to call instead of Google's API, such as a
# gateway. The harness still needs GEMINI_API_KEY set.
# GOOGLE_GEMINI_BASE_URL=

# DEBUG logs each run's model, and tool calls parking and resuming.
# LOG_LEVEL=WARNING

# Where the Next.js runtime reaches the Python agent.
AGENT_URL=http://localhost:8000
