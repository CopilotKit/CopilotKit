# Every showcase integration Dockerfile installs with `npm ci --legacy-peer-deps`.
# This app carries the UNION of their dependencies, so it inherits the same peer
# conflicts and needs the same flag. Setting it here keeps a plain `npm install`
# / `npm ci` identical to what the image build does.
#
# The conflicts this covers today:
#   * openai@5.x declares `peerOptional zod@^3.23.8`, but @tanstack/ai-openai
#     hard-requires `zod@^4`, so the root zod is v4 (see the "//zod" note in
#     package.json).
#   * @copilotkit/* and @ag-ui/* pin zod v3 internally; npm nests those copies.
legacy-peer-deps=true
