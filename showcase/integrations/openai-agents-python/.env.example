# Required. Read by the OpenAI client every agent uses.
OPENAI_API_KEY=sk-...

# Optional. An OpenAI-compatible server to call instead of api.openai.com.
# Showcase compose sets it to the in-network aimock replay server
# (http://aimock:4010/v1) with a fake key.
# OPENAI_BASE_URL=http://localhost:4010/v1

# Optional. Models the agents ask for (defaults: gpt-5.4 for both). The
# reasoning demos need a model that returns reasoning summaries.
# OPENAI_MODEL=gpt-5.4
# OPENAI_REASONING_MODEL=gpt-5.4

# Optional. Send Agents SDK traces to the OpenAI platform (off by default).
# OPENAI_AGENTS_TRACING=1

# Agent backend URL (for the CopilotKit runtime proxy in
# src/app/api/copilotkit*/route.ts)
AGENT_URL=http://localhost:8000

# Showcase
NEXT_PUBLIC_BASE_URL=http://localhost:3000
