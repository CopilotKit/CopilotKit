{
  "name": "showcase-strands-typescript-todo-tests",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.config.ts",
        "cwd": "showcase/integrations/strands-typescript/src/agent"
      },
      "dependsOn": ["install-dependencies"],
      "cache": false
    },
    "check-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit",
        "cwd": "showcase/integrations/strands-typescript/src/agent"
      },
      "dependsOn": ["install-dependencies"]
    },
    "install-dependencies": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund",
        "cwd": "showcase/integrations/strands-typescript/src/agent"
      },
      "cache": false
    }
  }
}
