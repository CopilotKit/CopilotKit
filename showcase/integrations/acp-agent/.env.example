# CopilotKit Intelligence project key and an external relay target
COPILOTKIT_API_KEY=ck_pub_...
COPILOTKIT_ACP_RUNTIME_INSTANCE_ID=rti_showcase_relay_01
COPILOTKIT_ACP_AGENT_ID=showcase-acp

# The production container starts a Showcase-owned external ACP fixture with
# these exact ids. For local dev, run `npm run relay` in a second terminal.

# A non-secret working-directory selector understood by the external agent.
# Intelligence stores this value inside unchanged ACP frames.
COPILOTKIT_ACP_CWD=/workspace

# Stable fixture identity for this public demo. Production apps should derive
# the app user from their authenticated request.
COPILOTKIT_ACP_SHOWCASE_USER_ID=showcase-acp-user

# Optional: set both when using a non-production Intelligence deployment.
# COPILOTKIT_INTELLIGENCE_API_URL=http://localhost:4100
# COPILOTKIT_INTELLIGENCE_WS_URL=ws://localhost:4101

# Showcase
NEXT_PUBLIC_BASE_URL=http://localhost:3000
