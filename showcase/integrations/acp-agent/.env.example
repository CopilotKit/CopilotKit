# CopilotKit Intelligence project key and trusted ACP profile
COPILOTKIT_API_KEY=ck_pub_...
COPILOTKIT_ACP_AGENT_PROFILE_ID=showcase-acp

# Stable fixture identity for this public demo. Production apps should derive
# the app user from their authenticated request.
COPILOTKIT_ACP_SHOWCASE_USER_ID=showcase-acp-user

# Optional: set both when using a non-production Intelligence deployment.
# COPILOTKIT_INTELLIGENCE_API_URL=http://localhost:4100
# COPILOTKIT_INTELLIGENCE_WS_URL=ws://localhost:4101

# Showcase
NEXT_PUBLIC_BASE_URL=http://localhost:3000
