# API Keys (shared across integrations)
OPENAI_API_KEY=replace-with-your-key

# Optional: route OpenAI calls through a proxy (e.g. the showcase aimock
# server for deterministic record/replay). When unset, calls go to OpenAI.
# The Worker reads these as bindings (entrypoint.sh sets
# CLOUDFLARE_INCLUDE_PROCESS_ENV=true for `wrangler dev`).
# OPENAI_BASE_URL=http://localhost:5555/v1

# Optional: model ids for the agents (defaults: gpt-6-luna for both).
# MODEL_ID=gpt-6-luna
# OPENAI_REASONING_MODEL=gpt-6-luna

# Agent backend URL: the Cloudflare Worker (`wrangler dev`) the CopilotKit
# runtime proxies to.
AGENT_URL=http://localhost:8000

# Showcase
NEXT_PUBLIC_BASE_URL=http://localhost:3000
