{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarative-gen-ui-catalog",
  "title": "Declarative Gen UI catalog",
  "description": "Server-side mirror of the components the declarative-gen-ui frontend renders (src/app/demos/declarative-gen-ui/a2ui/definitions.ts). Extends the A2UI v0.9 basic catalog; ag2 merges the two (custom wins on key collision, basic's $defs survive), so only the custom and overridden components are declared here. KEEP IN SYNC WITH definitions.ts — a prop that exists there but not here fails validation and silently degrades the surface to plain prose.",
  "catalogId": "declarative-gen-ui-catalog",
  "components": {
    "Row": {
      "type": "object",
      "description": "Horizontal layout container. Children share the width evenly. Use `gap` (px) to space dashboard tiles.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Row"
            },
            "gap": {
              "type": "number",
              "description": "Spacing between children, in px."
            },
            "align": {
              "type": "string",
              "description": "Alignment of children along the cross axis (vertically).",
              "enum": ["start", "center", "end", "stretch", "baseline"]
            },
            "justify": {
              "type": "string",
              "description": "Arrangement of children along the main axis (horizontally).",
              "enum": ["start", "center", "end", "spaceBetween"]
            },
            "children": {
              "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID.",
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Column": {
      "type": "object",
      "description": "Vertical layout container. Use `gap` (px) to space stacked sections.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Column"
            },
            "gap": {
              "type": "number",
              "description": "Spacing between children, in px."
            },
            "align": {
              "type": "string",
              "description": "Alignment of children along the cross axis (horizontally).",
              "enum": ["start", "center", "end", "stretch", "baseline"]
            },
            "children": {
              "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID.",
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Text": {
      "type": "object",
      "description": "A plain text line. Use for short explanations inside cards.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Text"
            },
            "text": {
              "type": "string",
              "description": "The text content to display."
            }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "description": "A titled card container with an optional subtitle and a single child slot. Use it to group related content (metrics, rows, buttons).",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Card"
            },
            "title": {
              "type": "string",
              "description": "The card heading."
            },
            "subtitle": {
              "type": "string",
              "description": "An optional secondary line under the title."
            },
            "child": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
              "description": "The ID of the single child component rendered inside the card. To display multiple elements, wrap them in a layout component (Column or Row) and pass that container's ID here. Do NOT define the child inline."
            }
          },
          "required": ["component", "title"]
        }
      ],
      "unevaluatedProperties": false
    },
    "StatusBadge": {
      "type": "object",
      "description": "A small coloured pill communicating the state of something (healthy/degraded/at-risk, on-track/behind). Choose `variant` to match the intent.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "StatusBadge"
            },
            "text": {
              "type": "string",
              "description": "The badge label."
            },
            "variant": {
              "type": "string",
              "description": "The badge colour, chosen to match the intent.",
              "enum": ["success", "warning", "error", "info"]
            }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Metric": {
      "type": "object",
      "description": "A key/value KPI tile with an optional trend indicator and trend delta. Ideal for dashboard KPI rows (e.g. 'Revenue • $4.2M • up 12%').",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Metric"
            },
            "label": {
              "type": "string",
              "description": "What the figure measures."
            },
            "value": {
              "type": "string",
              "description": "The pre-formatted figure (e.g. '$4.2M', '31%')."
            },
            "trend": {
              "type": "string",
              "description": "Direction of change versus the prior period.",
              "enum": ["up", "down", "neutral"]
            },
            "trendValue": {
              "type": "string",
              "description": "The pre-formatted delta (e.g. '+12% QoQ')."
            }
          },
          "required": ["component", "label", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "InfoRow": {
      "type": "object",
      "description": "A compact two-column 'label: value' row. Good for stacks of facts inside a Card (owner, region, ARR, renewal date, etc.).",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "InfoRow"
            },
            "label": {
              "type": "string",
              "description": "The fact's name."
            },
            "value": {
              "type": "string",
              "description": "The fact's value."
            }
          },
          "required": ["component", "label", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DataTable": {
      "type": "object",
      "description": "A data table with column headers and rows. Ideal for rankings and per-person/per-item breakdowns (rep performance vs quota, deal lists). Each row's keys MUST appear in `columns[].key`; unknown row keys render as blank cells and indicate model/schema drift.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DataTable"
            },
            "columns": {
              "type": "array",
              "description": "The column headers, in display order.",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The row key this column reads."
                  },
                  "label": {
                    "type": "string",
                    "description": "The header text."
                  }
                },
                "required": ["key", "label"]
              }
            },
            "rows": {
              "type": "array",
              "description": "One object per row. Cells may be strings or numbers — the renderer stringifies at render time.",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number"]
                }
              }
            }
          },
          "required": ["component", "columns", "rows"]
        }
      ],
      "unevaluatedProperties": false
    },
    "PrimaryButton": {
      "type": "object",
      "description": "A styled primary call-to-action button. Attach an optional `action` that will be dispatched back to the agent when the user clicks it.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "PrimaryButton"
            },
            "label": {
              "type": "string",
              "description": "The button text."
            },
            "action": {
              "description": "Opaque payload handed to the A2UI dispatch helper, which forwards it back to the agent. Shape is deliberately unconstrained — different demos use different action payloads."
            }
          },
          "required": ["component", "label"]
        }
      ],
      "unevaluatedProperties": false
    },
    "PieChart": {
      "type": "object",
      "description": "A pie/donut chart with a brand-coloured legend. Provide `title`, `description`, and `data` as an array of `{ label, value }` objects. Great for part-of-whole breakdowns (revenue by region, pipeline by stage).",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "PieChart"
            },
            "title": {
              "type": "string",
              "description": "The chart heading."
            },
            "description": {
              "type": "string",
              "description": "One line explaining what the slices represent."
            },
            "data": {
              "type": "array",
              "description": "The slices.",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "The slice name."
                  },
                  "value": {
                    "type": "number",
                    "description": "The slice magnitude."
                  }
                },
                "required": ["label", "value"]
              }
            }
          },
          "required": ["component", "title", "description", "data"]
        }
      ],
      "unevaluatedProperties": false
    },
    "BarChart": {
      "type": "object",
      "description": "A vertical bar chart built on Recharts. Provide `title`, `description`, and `data` as an array of `{ label, value }` objects. Great for comparing series across categories or time (monthly revenue, signups per month).",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "BarChart"
            },
            "title": {
              "type": "string",
              "description": "The chart heading."
            },
            "description": {
              "type": "string",
              "description": "One line explaining what the bars represent."
            },
            "data": {
              "type": "array",
              "description": "The bars.",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "The bar name."
                  },
                  "value": {
                    "type": "number",
                    "description": "The bar magnitude."
                  }
                },
                "required": ["label", "value"]
              }
            }
          },
          "required": ["component", "title", "description", "data"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
