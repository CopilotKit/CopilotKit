# Required. The Antigravity SDK reads only GEMINI_API_KEY; GOOGLE_API_KEY is
# accepted as a fallback because the showcase fleet exports that name.
# entrypoint.sh refuses to start with neither.
GEMINI_API_KEY=...

# Optional. A Gemini-compatible server to call instead of Google's API. Showcase
# compose sets it to the in-network aimock replay server (http://aimock:4010)
# and supplies a fake key: the harness wants one even there, and aimock ignores
# its value.
# GOOGLE_GEMINI_BASE_URL=http://localhost:4010

# Agent backend URL (for the CopilotKit runtime proxy in
# src/app/api/copilotkit*/route.ts)
AGENT_URL=http://localhost:8000

# Optional. Workspace the Go harness does its real file/shell work in, and the
# directory it writes session trajectories to. Keep the workspace path SHORT —
# a long, high-entropy path makes the model reproduce it wrongly in tool calls.
# Default to /data/... inside the container image; set both when running the
# agent outside Docker.
ANTIGRAVITY_WORKSPACE=/data/ws
ANTIGRAVITY_SAVE_DIR=/data/sessions

# Optional. Model the harness asks for on every turn (default: the SDK's
# default Gemini model).
# ANTIGRAVITY_MODEL=

# Showcase
NEXT_PUBLIC_BASE_URL=http://localhost:3000
