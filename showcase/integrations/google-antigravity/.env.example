# Required. Every model call goes through the in-process OpenAI-compatible shim
# (src/openai_proxy.py), which attaches `Authorization: Bearer $OPENAI_API_KEY`
# — the Antigravity Go harness has no API-key field of its own. Without it the
# shim refuses to start and the agent process dies at import (entrypoint.sh
# fails fast). Showcase compose supplies `sk-mock` for the aimock replay path.
OPENAI_API_KEY=sk-...

# Optional. OpenAI-compatible root the shim forwards to, SDK convention
# (trailing /v1). Defaults to https://api.openai.com/v1; showcase compose sets
# it to the in-network aimock replay server (http://aimock:4010/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# Agent backend URL (for the CopilotKit runtime proxy in
# src/app/api/copilotkit*/route.ts)
AGENT_URL=http://localhost:8000

# Optional. Workspace the Go harness does its real file/shell work in, and the
# directory it writes session trajectories to. Keep the workspace path SHORT —
# a long, high-entropy path makes the model reproduce it wrongly in tool calls.
# Default to /data/... inside the container image; set both when running the
# agent outside Docker.
ANTIGRAVITY_WORKSPACE=/data/ws
ANTIGRAVITY_SAVE_DIR=/data/sessions

# Optional. Model the harness asks for on every turn (default gpt-4.1-mini).
ANTIGRAVITY_MODEL=gpt-4.1-mini

# Showcase
NEXT_PUBLIC_BASE_URL=http://localhost:3000
