# The "Ask AI" agent (src/lib/docs-agent.ts) runs on OpenAI's gpt-6-luna.
# Copy to .env.local (gitignored) and set the key.
OPENAI_API_KEY=

# Telemetry (src/lib/telemetry, src/components/telemetry). Same names as
# showcase/shell-docs. All optional: an empty value turns that channel off.
# Read per request, so they can change without a rebuild. Each also accepts
# the name without the NEXT_PUBLIC_ prefix.
# PostHog project key for the browser (posthog-js, via /ingest).
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog project key for server-side events sent from src/proxy.ts
# (docs_pageview, docs.llm_text_fetched, seo_redirect).
POSTHOG_KEY=
# PostHog capture host for those server-side events (default: EU cloud).
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GOOGLE_ANALYTICS_TRACKING_ID=
NEXT_PUBLIC_SCARF_PIXEL_ID=
NEXT_PUBLIC_REO_KEY=
NEXT_PUBLIC_REB2B_KEY=

# Hosts the docs link to and frame (src/lib/runtime-config.ts). Optional: the
# defaults are production's, so staging sets its own. Read per request.
# The showcase shell (Angular "Run example" links, framework landings).
NEXT_PUBLIC_SHELL_URL=https://showcase.copilotkit.ai
# The CopilotKit dashboard: Intelligence sign-up, Copilot Cloud, API keys.
NEXT_PUBLIC_INTELLIGENCE_SIGNUP_URL=https://dashboard.operations.copilotkit.ai
# Each framework's demo deployment, framed by /examples and the demo embeds.
SHOWCASE_BACKEND_HOST_PATTERN=showcase-{slug}-production.up.railway.app
