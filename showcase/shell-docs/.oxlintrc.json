{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "nextjs"
  ],
  "jsPlugins": [
    "../../packages/react-ui/oxlint-rules/copilotkit-plugin.mjs"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.3.1"
    },
    "tailwindcss": {
      "callees": [
        "clsx",
        "cva",
        "cn"
      ]
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.{ts,tsx}"
      ],
      "rules": {
        "copilotkit/no-public-env-shell-read": "error"
      }
    },
    {
      "files": [
        "src/content/**",
        "src/lib/runtime-config*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}"
      ],
      "rules": {
        "copilotkit/no-public-env-shell-read": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/"
  ]
}
