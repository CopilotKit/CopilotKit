{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CopilotKit public AEO surface contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "policyUrl",
    "capabilitiesUrl",
    "canonicalHosts",
    "classifications",
    "compatibility",
    "responseSemantics",
    "owners",
    "surfaces",
    "policyLinkFiles",
    "reviewChecklist"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "$ref": "#/definitions/nonEmptyString" },
    "policyUrl": { "const": "https://docs.copilotkit.ai/aeo" },
    "capabilitiesUrl": {
      "const": "https://docs.copilotkit.ai/.well-known/copilotkit-capabilities/v1.json"
    },
    "canonicalHosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["website", "docs", "docsMcp"],
      "properties": {
        "website": { "const": "https://www.copilotkit.ai" },
        "docs": { "const": "https://docs.copilotkit.ai" },
        "docsMcp": { "const": "https://mcp.copilotkit.ai" }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "definition", "sourceUrls"],
        "properties": {
          "id": {
            "enum": ["standard", "community-convention", "copilotkit-contract"]
          },
          "label": { "$ref": "#/definitions/nonEmptyString" },
          "definition": { "$ref": "#/definitions/nonEmptyString" },
          "sourceUrls": {
            "type": "array",
            "items": { "$ref": "#/definitions/httpsUrl" }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "const": "standard" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "const": "community-convention" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "const": "copilotkit-contract" } }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updateCadence",
        "additiveChanges",
        "breakingChanges",
        "responseTypes"
      ],
      "properties": {
        "updateCadence": { "$ref": "#/definitions/nonEmptyString" },
        "additiveChanges": { "$ref": "#/definitions/nonEmptyString" },
        "breakingChanges": { "$ref": "#/definitions/nonEmptyString" },
        "responseTypes": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "responseSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successStatus",
        "missingStatus",
        "redirectStatuses",
        "htmlFallbacks"
      ],
      "properties": {
        "successStatus": { "const": 200 },
        "missingStatus": { "const": 404 },
        "redirectStatuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "htmlFallbacks": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "scope", "repository", "cadence"],
        "properties": {
          "id": { "$ref": "#/definitions/nonEmptyString" },
          "name": { "$ref": "#/definitions/nonEmptyString" },
          "scope": {
            "enum": ["repository", "external-repository", "external-service"]
          },
          "repository": { "$ref": "#/definitions/nonEmptyString" },
          "cadence": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/surface" }
    },
    "policyLinkFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/nonEmptyString" }
    },
    "reviewChecklist": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/nonEmptyString" }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "httpsUrl": { "type": "string", "pattern": "^https://" },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contentTypes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/\\S*$" },
        "contentTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "automatedEnforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "command", "paths"],
      "properties": {
        "mode": { "const": "automated" },
        "command": { "$ref": "#/definitions/nonEmptyString" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "manualExternalEnforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "manualOwner", "followUp"],
      "properties": {
        "mode": { "const": "manual-external" },
        "manualOwner": { "$ref": "#/definitions/nonEmptyString" },
        "followUp": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "endpoints",
        "classification",
        "owner",
        "guarantee",
        "enforcement"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "host": { "enum": ["website", "docs", "docsMcp"] },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/endpoint" }
        },
        "classification": {
          "enum": ["standard", "community-convention", "copilotkit-contract"]
        },
        "owner": { "$ref": "#/definitions/nonEmptyString" },
        "guarantee": { "$ref": "#/definitions/nonEmptyString" },
        "enforcement": {
          "oneOf": [
            { "$ref": "#/definitions/automatedEnforcement" },
            { "$ref": "#/definitions/manualExternalEnforcement" }
          ]
        }
      }
    }
  }
}
