{
  "name": "showcase-shared-python",
  "targets": {
    "test:provider-headers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m pytest showcase/shared/python/tests/test_provider_header_forwarding.py"
      },
      "cache": false,
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m pytest showcase/shared/python/tests/test_todos.py showcase/shared/python/tests/test_sales_todos.py"
      },
      "inputs": ["{projectRoot}/**/*"],
      "dependsOn": []
    },
    "test:todos": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m pytest showcase/shared/python/tests/test_todos.py showcase/shared/python/tests/test_sales_todos.py"
      },
      "inputs": ["{projectRoot}/**/*"],
      "dependsOn": []
    },
    "test:todos:browser": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node showcase/harness/test/browser/beautiful-chat-todos.mjs"
      },
      "cache": false,
      "dependsOn": []
    },
    "test:all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m pytest showcase/shared/python/tests"
      },
      "inputs": ["{projectRoot}/**/*"],
      "dependsOn": []
    }
  }
}
