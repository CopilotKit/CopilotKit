{
  "name": "@copilotkit/a2ui-renderer",
  "version": "1.87.0",
  "private": false,
  "description": "A2UI Renderer for CopilotKit - render A2UI surfaces in React applications",
  "keywords": [
    "a2ui",
    "ai",
    "copilotkit",
    "react",
    "renderer",
    "tanstack-intent",
    "ui"
  ],
  "homepage": "https://github.com/CopilotKit/CopilotKit",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git",
    "directory": "packages/a2ui-renderer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "typesVersions": {
    "*": {
      "engine": [
        "./dist/engine.d.cts"
      ],
      "engine-core": [
        "./dist/engine-core.d.cts"
      ],
      "catalog-schema": [
        "./dist/catalog-schema.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.mts",
        "default": "./dist/engine.mjs"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    },
    "./engine-core": {
      "import": {
        "types": "./dist/engine-core.d.mts",
        "default": "./dist/engine-core.mjs"
      },
      "require": {
        "types": "./dist/engine-core.d.cts",
        "default": "./dist/engine-core.cjs"
      }
    },
    "./catalog-schema": {
      "import": {
        "types": "./dist/catalog-schema.d.mts",
        "default": "./dist/catalog-schema.mjs"
      },
      "require": {
        "types": "./dist/catalog-schema.d.cts",
        "default": "./dist/catalog-schema.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "compat-check": "es-check es2022 --module 'dist/**/!(*.umd).{mjs,cjs,js}' && es-check es2018 'dist/**/*.umd.js'",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publint": "publint .",
    "attw": "attw --pack . --profile node16"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@copilotkit/core": "workspace:*",
    "@copilotkit/shared": "workspace:*",
    "clsx": "^2.1.1",
    "marked": "12.0.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.0.29",
    "@testing-library/react": "^16.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "tsdown": "^0.20.3",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18 || ^19 || ^19.0.0-rc",
    "react-dom": "^18 || ^19 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
