{
  "name": "@copilotkit/channels-web",
  "version": "0.12.0",
  "description": "Web (AG-UI) platform adapter for CopilotKit JSX channels (@copilotkit/channels), with a React renderer for posted UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git",
    "directory": "packages/channels-web"
  },
  "homepage": "https://github.com/CopilotKit/CopilotKit",
  "keywords": [
    "ai",
    "agent",
    "bot",
    "web",
    "chat",
    "copilotkit",
    "ag-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint .",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@copilotkit/channels-core": "workspace:^",
    "@copilotkit/channels-ui": "workspace:^"
  },
  "devDependencies": {
    "@copilotkit/typescript-config": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
