{
  "name": "@copilotkit/intelligence-delivery-core",
  "version": "0.0.0",
  "private": true,
  "description": "Internal shared learned skill delivery implementation bundled into framework adapters",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@copilotkit/runtime": "workspace:*",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@copilotkit/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/yauzl": "2.10.3",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "fflate": "0.8.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/.env*"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production"
        ]
      },
      "check-types": {
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  }
}
