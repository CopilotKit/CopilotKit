{
  "name": "@copilotkit/intelligence-mastra",
  "version": "1.71.2",
  "description": "Learned skill delivery for Mastra agents through CopilotKit Intelligence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint .",
    "attw": "attw --pack . --profile node16",
    "test-minimum": "node test/compatibility.mjs --lane minimum",
    "test-latest": "node test/compatibility.mjs --lane latest"
  },
  "dependencies": {
    "@copilotkit/runtime": "workspace:*",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@copilotkit/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "vitest": "^3.2.4",
    "zod": "4.6.1",
    "@copilotkit/intelligence-delivery-core": "workspace:*",
    "@mastra/core": "1.66.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0 <2",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/.env*"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  }
}
