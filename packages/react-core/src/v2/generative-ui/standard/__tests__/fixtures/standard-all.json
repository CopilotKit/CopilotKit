{
  "components": [
    {
      "id": "root",
      "component": "Column",
      "gap": 4,
      "children": [
        "title",
        "s-layout",
        "s-text",
        "s-inputs",
        "s-feedback",
        "s-data",
        "s-media",
        "s-composites"
      ]
    },
    {
      "id": "title",
      "component": "Title",
      "text": "Standard catalog fixture",
      "size": "xl"
    },
    {
      "id": "box",
      "component": "Box",
      "gap": 2,
      "padding": 2,
      "border": true,
      "radius": "md",
      "children": ["row"]
    },
    {
      "id": "row",
      "component": "Row",
      "gap": 2,
      "align": "center",
      "justify": "spaceBetween",
      "wrap": "wrap",
      "children": ["spacer-l", "grid", "spacer-r"]
    },
    {
      "id": "spacer-l",
      "component": "Spacer",
      "minSize": 1
    },
    {
      "id": "spacer-r",
      "component": "Spacer"
    },
    {
      "id": "grid",
      "component": "Grid",
      "columns": 2,
      "gap": 2,
      "children": ["gi1", "gi2"]
    },
    {
      "id": "gi1",
      "component": "GridItem",
      "span": 1,
      "children": ["gi1-t"]
    },
    {
      "id": "gi1-t",
      "component": "Text",
      "text": "Grid item one"
    },
    {
      "id": "gi2",
      "component": "GridItem",
      "children": ["gi2-t"]
    },
    {
      "id": "gi2-t",
      "component": "Text",
      "text": "Grid item two"
    },
    {
      "id": "flow",
      "component": "Flow",
      "columns": 2,
      "children": ["fi"]
    },
    {
      "id": "fi",
      "component": "FlowItem",
      "aspectRatio": "2 / 1",
      "children": ["fi-t"]
    },
    {
      "id": "fi-t",
      "component": "Text",
      "text": "Flow item"
    },
    {
      "id": "carousel",
      "component": "Carousel",
      "label": "Slides",
      "visibleItems": 2,
      "children": ["ci1", "ci2", "cmi"]
    },
    {
      "id": "ci1",
      "component": "CarouselItem",
      "children": ["ci1-t"]
    },
    {
      "id": "ci1-t",
      "component": "Text",
      "text": "Slide one"
    },
    {
      "id": "ci2",
      "component": "CarouselItem",
      "children": ["ci2-t"]
    },
    {
      "id": "ci2-t",
      "component": "Text",
      "text": "Slide two"
    },
    {
      "id": "cmi",
      "component": "CarouselMediaItem",
      "url": "https://example.com/slide.png",
      "description": "Slide three",
      "size": "sm",
      "children": ["cmi-t"]
    },
    {
      "id": "cmi-t",
      "component": "Caption",
      "text": "Media slide"
    },
    {
      "id": "divider",
      "component": "Divider",
      "color": "subtle"
    },
    {
      "id": "tabs",
      "component": "Tabs",
      "tabs": [
        {
          "title": "Plan",
          "child": "tab-plan"
        },
        {
          "title": "Usage",
          "child": "tab-usage"
        }
      ]
    },
    {
      "id": "tab-plan",
      "component": "Text",
      "text": "Plan panel"
    },
    {
      "id": "tab-usage",
      "component": "Text",
      "text": "Usage panel"
    },
    {
      "id": "s-layout",
      "component": "Card",
      "variant": "soft",
      "gap": 2,
      "children": [
        "s-layout-title",
        "box",
        "flow",
        "carousel",
        "divider",
        "tabs"
      ]
    },
    {
      "id": "s-layout-title",
      "component": "Caption",
      "text": "Layout"
    },
    {
      "id": "text",
      "component": "Text",
      "text": "Body with **bold**, *italic* and `code` [link](https://copilotkit.ai)",
      "children": ["badge"]
    },
    {
      "id": "badge",
      "component": "Badge",
      "label": "New",
      "color": "success"
    },
    {
      "id": "label",
      "component": "Label",
      "text": "A label"
    },
    {
      "id": "bold",
      "component": "Bold",
      "text": "Bold text"
    },
    {
      "id": "italic",
      "component": "Italic",
      "text": "Italic text"
    },
    {
      "id": "underline",
      "component": "Underline",
      "text": "Underlined text"
    },
    {
      "id": "strike",
      "component": "Strikethrough",
      "text": "Struck text"
    },
    {
      "id": "quote",
      "component": "Blockquote",
      "text": "A quoted **line**"
    },
    {
      "id": "code",
      "component": "Code",
      "text": "const x = 1;",
      "language": "ts"
    },
    {
      "id": "md",
      "component": "Markdown",
      "text": "## Markdown heading\n\n- item a\n- item b"
    },
    {
      "id": "math",
      "component": "Math",
      "value": "E = mc^2",
      "block": true
    },
    {
      "id": "shimmer",
      "component": "ShimmerText",
      "text": "Thinking"
    },
    {
      "id": "link",
      "component": "Link",
      "text": "CopilotKit",
      "href": "https://copilotkit.ai"
    },
    {
      "id": "tooltip",
      "component": "Tooltip",
      "trigger": "tooltip-t",
      "content": "tooltip-c"
    },
    {
      "id": "tooltip-t",
      "component": "Text",
      "text": "Hover me"
    },
    {
      "id": "tooltip-c",
      "component": "Text",
      "text": "Tooltip content"
    },
    {
      "id": "s-text",
      "component": "Card",
      "variant": "soft",
      "gap": 2,
      "children": [
        "s-text-title",
        "text",
        "label",
        "bold",
        "code",
        "italic",
        "underline",
        "strike",
        "quote",
        "md",
        "math",
        "shimmer",
        "link",
        "tooltip"
      ]
    },
    {
      "id": "s-text-title",
      "component": "Caption",
      "text": "Text"
    },
    {
      "id": "form",
      "component": "Form",
      "gap": 2,
      "onSubmit": {
        "event": {
          "name": "submit_form",
          "userMessage": "Send the form",
          "context": {
            "name": {
              "@path": "/form/name"
            }
          }
        }
      },
      "children": [
        "tf",
        "ta",
        "sel",
        "cb",
        "radio",
        "rg",
        "slider",
        "seg",
        "cp",
        "dt",
        "press",
        "btn"
      ]
    },
    {
      "id": "tf",
      "component": "TextField",
      "value": {
        "@path": "/form/name"
      },
      "label": "Name",
      "placeholder": "Your name",
      "checks": [
        {
          "condition": {
            "@call": "required",
            "args": {
              "value": {
                "@path": "/form/name"
              }
            }
          },
          "message": "Name is required"
        }
      ]
    },
    {
      "id": "ta",
      "component": "TextArea",
      "value": {
        "@path": "/form/notes"
      },
      "label": "Notes",
      "rows": 2
    },
    {
      "id": "sel",
      "component": "Select",
      "value": {
        "@path": "/form/plan"
      },
      "label": "Plan",
      "options": [
        "Free",
        "Team",
        {
          "value": "ent",
          "label": "Enterprise"
        }
      ]
    },
    {
      "id": "cb",
      "component": "CheckBox",
      "value": {
        "@path": "/form/annual"
      },
      "label": "Annual billing"
    },
    {
      "id": "radio",
      "component": "Radio",
      "value": "solo",
      "label": "Solo radio"
    },
    {
      "id": "rg",
      "component": "RadioGroup",
      "value": {
        "@path": "/form/size"
      },
      "label": "Size",
      "options": ["S", "M", "L"]
    },
    {
      "id": "slider",
      "component": "Slider",
      "value": {
        "@path": "/form/seats"
      },
      "label": "Seats",
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "id": "seg",
      "component": "SegmentedControl",
      "value": {
        "@path": "/form/period"
      },
      "label": "Billing period",
      "options": ["Monthly", "Yearly"]
    },
    {
      "id": "cp",
      "component": "ChoicePicker",
      "value": {
        "@path": "/form/tags"
      },
      "label": "Tags",
      "variant": "multipleSelection",
      "displayStyle": "chips",
      "options": [
        "Design",
        "Code",
        {
          "value": "ops",
          "label": "Operations"
        }
      ]
    },
    {
      "id": "dt",
      "component": "DateTimeInput",
      "value": {
        "@path": "/form/date"
      },
      "label": "Start date"
    },
    {
      "id": "press",
      "component": "Pressable",
      "padding": 2,
      "border": true,
      "onClick": {
        "event": {
          "name": "pressed"
        }
      },
      "children": ["press-t"]
    },
    {
      "id": "press-t",
      "component": "Text",
      "text": "Pressable area"
    },
    {
      "id": "btn",
      "component": "Button",
      "label": "Submit",
      "submit": true,
      "icon": "send",
      "checks": [
        {
          "condition": {
            "@call": "required",
            "args": {
              "value": {
                "@path": "/form/name"
              }
            }
          }
        }
      ]
    },
    {
      "id": "s-inputs",
      "component": "Card",
      "variant": "soft",
      "gap": 2,
      "children": ["s-inputs-title", "form"]
    },
    {
      "id": "s-inputs-title",
      "component": "Caption",
      "text": {
        "@call": "formatString",
        "args": {
          "value": "Inputs (${/form/seats} seats, ${formatCurrency(value: /form/total, currency: 'EUR')})"
        }
      }
    },
    {
      "id": "loading",
      "component": "Loading",
      "label": "Loading data"
    },
    {
      "id": "loadind",
      "component": "LoadingIndicator",
      "size": "sm"
    },
    {
      "id": "loadblk",
      "component": "LoadingBlock",
      "label": "Placeholder"
    },
    {
      "id": "pulse",
      "component": "PulseIndicator",
      "color": "info"
    },
    {
      "id": "celeb",
      "component": "Celebration",
      "trigger": "done",
      "children": ["celeb-t"]
    },
    {
      "id": "celeb-t",
      "component": "Text",
      "text": "Celebrate"
    },
    {
      "id": "flash",
      "component": "FlashcardFlip",
      "front": "Front side",
      "back": "Back side",
      "hint": "Click to flip"
    },
