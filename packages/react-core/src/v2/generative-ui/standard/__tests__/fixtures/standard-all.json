      "children": ["pop-c-t"]
    },
    {
      "id": "pop-c-t",
      "component": "Text",
      "text": "Popover body"
    },
    {
      "id": "modal",
      "component": "Modal",
      "title": "Details",
      "trigger": "modal-t",
      "content": "modal-c"
    },
    {
      "id": "modal-t",
      "component": "Button",
      "label": "Open details"
    },
    {
      "id": "modal-c",
      "component": "Text",
      "text": "Modal body"
    },
    {
