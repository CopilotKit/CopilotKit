{
  "name": "@copilotkit/react-core",
  "version": "1.83.0",
  "private": false,
  "keywords": [
    "ai",
    "assistant",
    "automation",
    "copilot",
    "copilotkit",
    "javascript",
    "nextjs",
    "nodejs",
    "react",
    "tanstack-intent",
    "textarea"
  ],
  "homepage": "https://github.com/CopilotKit/CopilotKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./v2": {
      "import": "./dist/v2/index.mjs",
      "require": "./dist/v2/index.cjs"
    },
    "./v2/generative-ui": {
      "import": "./dist/v2/generative-ui.mjs",
      "require": "./dist/v2/generative-ui.cjs"
    },
    "./package.json": "./package.json",
    "./v2/context": {
      "import": "./dist/v2/context.mjs",
      "require": "./dist/v2/context.cjs"
    },
    "./v2/headless": {
      "import": "./dist/v2/headless.mjs",
      "require": "./dist/v2/headless.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/generate-external-reexports.mjs --check && node scripts/generate-stylesheet.mjs --check && tsdown && node ../../scripts/deprecations/v1-dist-notices.mjs --entrypoint react-core && node scripts/context-singleton-preflight.mjs",
    "size": "size-limit",
    "size:headline": "node scripts/measure-copilotchat.mjs",
    "size:assert-headless": "node scripts/assert-headless-purity.mjs",
    "compat-check": "es-check es2022 --module 'dist/**/!(*.umd).{mjs,cjs,js}' && es-check es2020 'dist/**/*.umd.js'",
    "dev": "tsdown --watch",
    "test": "vitest run && pnpm run test:scripts",
    "test:scripts": "node --test scripts/__tests__/measure-copilotchat.test.mjs scripts/__tests__/assert-headless-purity.test.mjs scripts/__tests__/generate-external-reexports.test.mjs",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "link:global": "pnpm link --global",
    "unlink:global": "pnpm unlink --global",
    "publint": "publint .",
    "attw": "attw --pack . --profile node16",
    "generate:external-reexports": "node scripts/generate-external-reexports.mjs",
    "test:browser-scroll": "node --test browser-tests/hidden-chat-scroll.test.mjs",
    "test:browser": "playwright test --config browser/playwright.config.ts"
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/a2ui-renderer": "workspace:*",
    "@copilotkit/core": "workspace:*",
    "@copilotkit/markdown-renderer": "workspace:*",
    "@copilotkit/mcp-apps-renderer": "workspace:*",
    "@copilotkit/runtime-client-gql": "workspace:*",
    "@copilotkit/shared": "workspace:*",
    "@copilotkit/web-components": "workspace:*",
    "@copilotkit/web-inspector": "workspace:*",
    "@jetbrains/websandbox": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@scarf/scarf": "^1.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "lit": "^3.3.2",
    "lucide-react": "^0.525.0",
    "recharts": "^3.1.0",
    "rxjs": "7.8.1",
    "untruncate-json": "^0.0.1",
    "use-stick-to-bottom": "^1.1.1",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "@tanstack/intent": "^0.0.29",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.0.2",
    "@valibot/to-json-schema": "^1.5.0",
    "arktype": "^2.1.29",
    "concurrently": "^9.1.0",
    "eslint": "^8.56.0",
    "jsdom": "^26.1.0",
    "maplibre-gl": "^5.0.0",
    "phoenix": "^1.8.4",
    "playwright": "1.59.1",
    "react": "^19.1.0",
    "react-dom": "^19.2.0",
    "tsconfig": "workspace:*",
    "tsdown": "^0.20.3",
    "typescript": "^5.2.3",
    "valibot": "^1.2.0",
    "vitest": "^3.2.4",
    "zod": ">=3.0.0",
    "@playwright/test": "^1.59.1"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0",
    "react": "^18 || ^19 || ^19.0.0-rc",
    "react-dom": "^18 || ^19 || ^19.0.0-rc",
    "zod": ">=3.25"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "nx": {
    "targets": {
      "test:browser": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
