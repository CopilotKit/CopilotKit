{
  "implicitDependencies": ["@copilotkit/a11y-test-kit"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/a11y/**/*",
        "{projectRoot}/vitest.config.mjs",
        "{workspaceRoot}/packages/a11y-test-kit/**/*"
      ]
    },
    "test:a11y": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/react-core",
        "command": "vitest run a11y/__tests__ --maxWorkers=1 --fileParallelism=false"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/a11y/**/*",
        "{projectRoot}/vitest.config.mjs",
        "{workspaceRoot}/packages/a11y-test-kit/**/*"
      ],
      "cache": true
    },
    "check-types:a11y": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/react-core",
        "command": "tsc --noEmit -p a11y/tsconfig.json"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/a11y/**/*",
        "{workspaceRoot}/packages/a11y-test-kit/**/*"
      ],
      "cache": true
    }
  }
}
