{
  "extends": "@copilotkit/typescript-config/base.json",
  "include": ["."],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "resolveJsonModule": true
  },
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/*"
  ]
}
