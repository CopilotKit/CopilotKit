{
  "name": "@copilotkit/angular",
  "version": "0.6.0",
  "description": "Angular library for CopilotKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git",
    "directory": "packages/angular"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/fesm2022/copilotkit-angular.mjs",
  "module": "dist/fesm2022/copilotkit-angular.mjs",
  "types": "dist/types/copilotkit-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/copilotkit-angular.d.ts",
      "default": "./dist/fesm2022/copilotkit-angular.mjs"
    },
    "./a2ui": {
      "types": "./dist/types/copilotkit-angular-a2ui.d.ts",
      "default": "./dist/fesm2022/copilotkit-angular-a2ui.mjs"
    },
    "./mcp-apps": {
      "types": "./dist/types/copilotkit-angular-mcp-apps.d.ts",
      "default": "./dist/fesm2022/copilotkit-angular-mcp-apps.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "copilotkit": {
    "angularSupport": {
      "compilerMajor": 22,
      "rxjs": "^7.8.0",
      "testedRxjs": "7.8.1",
      "supportedMajors": [
        {
          "angular": "22.0.0",
          "cdk": "22.0.0",
          "cli": "22.0.0",
          "major": 22,
          "typescript": "6.0.3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/generate-package-version.mjs && node scripts/generate-stylesheet.mjs && ng-packagr -p ng-package.json -c tsconfig.json && node scripts/normalize-package-exports.mjs",
    "dev": "node scripts/generate-package-version.mjs && node scripts/generate-stylesheet.mjs && ng-packagr -p ng-package.json -c tsconfig.json --watch",
    "check-types": "node scripts/generate-package-version.mjs && node scripts/generate-stylesheet.mjs && tsc --noEmit",
    "test": "node scripts/generate-package-version.mjs && node scripts/generate-stylesheet.mjs && vitest run",
    "test:watch": "node scripts/generate-package-version.mjs && node scripts/generate-stylesheet.mjs && vitest --watch",
    "publint": "publint .",
    "attw": "attw --pack . --profile node16"
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/core": "workspace:^",
    "@copilotkit/mcp-apps-renderer": "workspace:^",
    "@copilotkit/shared": "workspace:^",
    "@copilotkit/web-components": "workspace:^",
    "@copilotkit/web-inspector": "workspace:^",
    "@jetbrains/websandbox": "^1.1.3",
    "dompurify": "^3.4.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^12.0.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.0",
    "zod": "^3.25.75",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@analogjs/vitest-angular": "2.7.0",
    "@angular-devkit/architect": "0.2200.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@copilotkit/typescript-config": "workspace:*",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.5.1",
    "@vitest/ui": "^3.2.4",
    "axe-core": "4.11.1",
    "chokidar": "4.0.3",
    "jsdom": "^24.0.0",
    "ng-packagr": "22.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "^7.8.0"
  }
}
