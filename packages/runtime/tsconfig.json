{
  "extends": "@copilotkit/typescript-config/base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "target": "es2022",
    // es2023 lib for Array.prototype.toReversed (used by the service adapters)
    "lib": ["es2023", "dom", "dom.iterable"],
    // tsdown does the build and does not read these two settings. They are
    // here for the typecheck only.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.test.ts",
    "./src/**/__tests__/*",
    "./tests/**/*.ts"
  ],
  "exclude": ["dist", "build", "node_modules"],
  // ts-node runs scripts with extensionless CJS-style imports. Without this
  // override it uses module ESNext from above and runs the script as ESM,
  // which cannot resolve those imports. moduleResolution "Bundler" does not
  // work with module "commonjs", so ts-node uses "node" here.
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node"
    }
  }
}
