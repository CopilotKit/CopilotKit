{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "target": "es2022",
    // es2023 lib for Array.prototype.toReversed (used by the service adapters)
    "lib": ["es2023", "dom", "dom.iterable"],
    // module esnext so dynamic import() typechecks and pairs with the base
    // config's moduleResolution "bundler" (build is done by tsdown, which
    // does not read this setting)
    "module": "esnext",
    "useDefineForClassFields": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.test.ts",
    "./src/**/__tests__/*",
    "./tests/**/*.ts"
  ],
  "exclude": ["dist", "build", "node_modules"]
}
