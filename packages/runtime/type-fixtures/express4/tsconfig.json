{
  // The Express 4 half of the declared peer range, `^4.18.0 || ^5.0.0`.
  //
  // Sibling of express5/tsconfig.json: same consumer, same settings, `express`
  // pointed at major 4 instead. The fix for #7276 was to stop deriving
  // `CopilotExpressRouter` from one major's `Router`, so the claim to check is
  // that the published declarations mount on BOTH majors. Checking only the one
  // that was broken would leave the other free to break unnoticed.
  //
  // Note that only express 5 is installed at runtime here: the root
  // `pnpm.overrides` pins `express: ">=4.20.0"`, which resolves to 5.x for the
  // whole workspace. This project therefore proves the TYPE half of express 4
  // support. Nothing in this repository executes express 4.
  //
  // Run by `pnpm --filter @copilotkit/runtime check-dts`, which depends on
  // `build`.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "express": ["../../node_modules/@types/express"],
      "@copilotkit/runtime/v2/express": ["../../dist/v2/express.d.mts"],
      "@copilotkit/runtime/v2": ["../../dist/v2/index.d.mts"]
    }
  },
  "include": ["../consumer.ts"]
}
