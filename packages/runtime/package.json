{
  "name": "@copilotkit/runtime",
  "version": "1.83.0",
  "private": false,
  "keywords": [
    "ai",
    "assistant",
    "automation",
    "copilot",
    "copilotkit",
    "javascript",
    "nextjs",
    "nodejs",
    "react",
    "tanstack-intent",
    "textarea"
  ],
  "homepage": "https://github.com/CopilotKit/CopilotKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopilotKit/CopilotKit.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./dist/v2/index.mjs",
    "./dist/v2/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./internal/learned-skills": {
      "import": "./dist/internal/learned-skills.mjs",
      "require": "./dist/internal/learned-skills.cjs"
    },
    "./node": {
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "link:global": "pnpm link --global",
    "unlink:global": "pnpm unlink --global",
    "check-dts": "tsx ../../scripts/validate-dts-ambient.ts dist && tsx ../../scripts/validate-dts-imports.ts dist && tsx ../../scripts/validate-optional-peer-entries.ts . && tsx ../../scripts/validate-module-scope-create-require.ts . && tsc --noEmit -p type-fixtures/express4/tsconfig.json && tsc --noEmit -p type-fixtures/express5/tsconfig.json && tsc --noEmit -p type-fixtures/learning-management/tsconfig.json",
    "publint": "publint .",
    "attw": "attw --pack . --profile node16"
  },
  "dependencies": {
    "@ag-ui/a2ui-middleware": "0.0.10",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@ag-ui/mcp-apps-middleware": "^0.1.1",
    "@ag-ui/mcp-middleware": "0.0.2",
    "@ai-sdk/anthropic": "^3.0.49",
    "@ai-sdk/google": "^3.0.33",
    "@ai-sdk/google-vertex": "^3.0.97",
    "@ai-sdk/mcp": "^1.0.21",
    "@ai-sdk/openai": "^3.0.36",
    "@cfworker/json-schema": "^4.1.1",
    "@copilotkit/channels-core": "workspace:^",
    "@copilotkit/channels-intelligence": "workspace:^",
    "@copilotkit/license-verifier": "~0.5.0",
    "@copilotkit/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@remix-run/node-fetch-server": "^0.13.0",
    "@scarf/scarf": "^1.3.0",
    "ai": "^6.0.104",
    "openai": "^4.85.1 || >=5.0.0",
    "phoenix": "^1.8.4",
    "pino": "^10.1.1",
    "pino-pretty": "^11.2.1",
    "rxjs": "7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.25.18",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "latest",
    "@copilotkit/channels": "workspace:*",
    "@swc/core": "1.5.28",
    "@tanstack/intent": "^0.0.29",
    "@types/express": "^4.17.21",
    "@types/express-v5": "npm:@types/express@^5.0.0",
    "@types/node": "^18.11.17",
    "@types/phoenix": "^1.6.6",
    "@valibot/to-json-schema": "^1.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@whatwg-node/server": "^0.9.34",
    "arktype": "^2.1.29",
    "elysia": "^1.2.25",
    "eslint": "^8.56.0",
    "express": "^4.18.0 || ^5.0.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsconfig": "workspace:*",
    "tsdown": "^0.20.3",
    "typescript": "^5.2.3",
    "valibot": "^1.2.0",
    "vitest": "^3.2.4",
    "@types/yauzl": "2.10.3",
    "hono": "^4.11.4",
    "@hono/node-server": "^1.13.5"
  },
  "peerDependencies": {
    "openai": "^4.85.1 || >=5.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
