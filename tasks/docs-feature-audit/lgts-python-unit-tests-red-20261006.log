                    "LGT_REQUIRE_BEHAVIORAL=1 but node is not on PATH — cannot "
                    "run the HIGH-1 guard-fires proof."
                )
            pytest.skip("node not on PATH")
    
        agent_dir = _PKG_ROOT / "src" / "agent"
        preload = agent_dir / "disable-file-persistence.mjs"
