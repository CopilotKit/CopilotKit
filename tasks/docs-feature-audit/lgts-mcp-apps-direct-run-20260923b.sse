data: {"type":"RAW","event":{"event":"on_chain_start","data":{"input":{"copilotkit":{"actions":[{"type":"function","name":"create_view","function":{"name":"create_view","description":"Renders a hand-drawn diagram using Excalidraw elements.\nElements stream in one by one with draw-on animations.\nCall read_me first to learn the element format.\n[UI Resource: ui://excalidraw/mcp-app.html]","parameters":{"type":"object","properties":{"elements":{"type":"string","description":"JSON array string of Excalidraw elements. Must be valid JSON — no comments, no trailing commas. Keep compact. Call read_me first for format reference."}},"required":["elements"],"$schema":"http://json-schema.org/draft-07/schema#"}}}],"context":[]},"messages":[{"id":"36E4A61B-A04B-41EB-BC54-161223EC8FCF","content":"Open Excalidraw and sketch a system diagram with a client, server, and database.","additional_kwargs":{},"response_metadata":{},"type":"human"}]}},"name":"chat_node","tags":["graph:step:1"],"run_id":"01a0d04b-c259-763f-b0b8-f3117c54b3ab","metadata":{"ls_integration":"langgraph","created_by":"system","graph_id":"mcp_apps","assistant_id":"dfd3f5b1-4e03-5dc0-bf3e-e991e46509ce","run_attempt":1,"langgraph_version":"1.4.17","langgraph_plan":"developer","langgraph_host":"self-hosted","langgraph_api_url":"http://localhost:8123","thread_id":"bdc76237-3010-4df9-8a29-a4cbcd4625e7","run_id":"01a0d04b-c23c-7008-b5a1-cde0a462f352","langgraph_step":1,"langgraph_node":"chat_node","langgraph_triggers":["branch:to:chat_node"],"langgraph_path":["__pregel_pull","chat_node"],"langgraph_checkpoint_ns":"chat_node:007c4e19-4b13-58ee-98d2-6571458c28a5","checkpoint_ns":"chat_node:007c4e19-4b13-58ee-98d2-6571458c28a5"}}}

data: {"type":"RAW","event":{"event":"on_chat_model_start","data":{"input":{"messages":[[{"content":"You draw simple diagrams in Excalidraw via the MCP tool.\n\nSPEED MATTERS. Produce a correct-enough diagram fast; do not optimize\nfor polish. Target: one tool call, done in seconds.\n\nWhen the user asks for a diagram:\n1. Call `create_view` ONCE with 3-5 elements total: shapes + arrows +\n   an optional title text.\n2. Use straightforward shapes (rectangle, ellipse, diamond) with plain\n   `label` fields (`{\"text\": \"...\", \"fontSize\": 18}`) on them.\n3. Connect with arrows. Endpoints can be element centers or simple\n   coordinates — you don't need edge anchors / fixedPoint bindings.\n4. Include ONE `cameraUpdate` at the END of the elements array that\n   frames the whole diagram. Use an approved 4:3 size (600x450 or\n   800x600). No opening camera needed.\n5. Reply with ONE short sentence describing what you drew.\n\nEvery element needs a unique string `id` (e.g. `\"b1\"`, `\"a1\"`,\n`\"title\"`). Standard sizes: rectangles 160x70, ellipses/diamonds\n120x80, 40-80px gap between shapes.\n\nDo NOT:\n- Call `read_me`. You already know the basic shape API.\n- Make multiple `create_view` calls.\n- Iterate or refine. Ship on the first shot.\n- Add decorative colors / fills / zone backgrounds unless the user\n  explicitly asks for them.\n- Add labels on arrows unless crucial.\n\nIf the user asks for something specific (colors, more elements,\nparticular layout), follow their lead — but still in ONE call.","additional_kwargs":{},"response_metadata":{},"type":"system"},{"id":"36E4A61B-A04B-41EB-BC54-161223EC8FCF","content":"Open Excalidraw and sketch a system diagram with a client, server, and database.","additional_kwargs":{},"response_metadata":{},"type":"human"}]]}},"name":"ChatOpenAI","tags":[],"run_id":"01a0d04b-c25a-71d8-991e-7d288ada9755","metadata":{"ls_integration":"langchain_chat_model","created_by":"system","graph_id":"mcp_apps","assistant_id":"dfd3f5b1-4e03-5dc0-bf3e-e991e46509ce","run_attempt":1,"langgraph_version":"1.4.17","langgraph_plan":"developer","langgraph_host":"self-hosted","langgraph_api_url":"http://localhost:8123","thread_id":"bdc76237-3010-4df9-8a29-a4cbcd4625e7","run_id":"01a0d04b-c23c-7008-b5a1-cde0a462f352","langgraph_step":1,"langgraph_node":"chat_node","langgraph_triggers":["branch:to:chat_node"],"langgraph_path":["__pregel_pull","chat_node"],"langgraph_checkpoint_ns":"chat_node:007c4e19-4b13-58ee-98d2-6571458c28a5","checkpoint_ns":"chat_node:007c4e19-4b13-58ee-98d2-6571458c28a5","ls_provider":"openai","ls_model_name":"gpt-5-mini","ls_model_type":"chat","ls_temperature":0,"versions":{"@langchain/core":"1.2.12","@langchain/openai":"1.5.13"}}}}

