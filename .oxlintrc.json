{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint-json-schema/refs/heads/main/.oxlintrc.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "import"],
  "jsPlugins": ["./tools/oxlint-rules/copilotkit-plugin.mjs"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "unicorn/no-array-sort": "off",
    "copilotkit/require-cpk-prefix": "off",
    "no-restricted-imports": "off",

    "typescript/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "typescript/no-import-type-side-effects": "warn",
    "import/consistent-type-specifier-style": ["warn", "prefer-top-level"],

    "react/self-closing-comp": "warn",
    "unicorn/prefer-optional-catch-binding": "warn",
    "eslint/no-useless-computed-key": "warn",
    "unicorn/prefer-string-slice": "warn",
    "unicorn/prefer-array-flat-map": "warn"
  },
  "overrides": [
    // The lint gate (scripts/lint/gate.ts, `pnpm lint`). Package source only.
    // Errors fail CI unless .lint-baseline/oxlint.json allows them. Rules
    // that need types run only in the gate's `--type-aware` pass over
    // packages/. Warnings are not gated.
    {
      "files": ["packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx}"],
      "rules": {
        // The first five rules have no baseline entries. Fix new hits. Do
        // not add them to the baseline.
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/await-thenable": "error",
        "typescript/switch-exhaustiveness-check": "error",
        // The runtime throws a Response on purpose; the fetch handler
        // catches it and returns it.
        "typescript/only-throw-error": [
          "error",
          { "allow": [{ "from": "lib", "name": "Response" }] }
        ],
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/require-await": "error",
        "typescript/no-explicit-any": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": "allow-with-description",
            "ts-ignore": "allow-with-description",
            "ts-nocheck": true,
            "ts-check": false
          }
        ],
        "copilotkit/no-swallowed-error": "error",
        "copilotkit/require-disable-reason": "error",
        // Dead branches: a condition that the types say is always true or
        // always false.
        "typescript/no-unnecessary-condition": "error",
        // Oversized modules. Split a file before it passes 800 lines of code.
        "eslint/max-lines": [
          "error",
          { "max": 800, "skipBlankLines": true, "skipComments": true }
        ],

        // Every rule in the correctness and suspicious categories. The
        // top-level "categories" set them to warn for the whole repo, and an
        // override cannot set a category, so they are listed here one by one.
        // scripts/__tests__/lint-category-rules.test.ts fails when an oxlint
        // upgrade adds a rule to these categories that is not listed here.
        // Rules that are "off" at the top level stay off.
        // Category: correctness.
        "eslint/constructor-super": "error",
        "eslint/for-direction": "error",
        "eslint/no-async-promise-executor": "error",
        "eslint/no-caller": "error",
        "eslint/no-class-assign": "error",
        "eslint/no-compare-neg-zero": "error",
        "eslint/no-cond-assign": "error",
        "eslint/no-const-assign": "error",
