        "packages/**/*.test.*",
        "packages/**/*.spec.*",
        "packages/**/test/**",
        "packages/**/tests/**",
        "packages/**/e2e/**",
        "packages/**/*.test-d.*",
        "packages/**/fixtures/**",
        "packages/**/type-fixtures/**",
        "packages/**/__mocks__/**",
        "packages/**/test-helpers/**",
        "packages/**/*-test-helpers.*",
        "packages/**/vitest.config.*",
        "packages/**/test-setup.ts"
