# The CLI writes these server-only values to .env.local.
CPK_INTELLIGENCE_API_KEY=
CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=
# A unique local developer ID; replace identifyUser with real auth before deploying.
CPK_APP_USER_ID=local-developer
# Defaults point to managed Intelligence. Set both for self-hosting.
# INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
# INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai

# Optional Ant profile; OAuth credentials stay in Ant's profile store.
# ANTHROPIC_PROFILE=work
# Deployment alternative to Ant OAuth:
# ANTHROPIC_API_KEY=
# Optional resource overrides instead of claude-lock.json:
# ANTHROPIC_AGENT_ID=agent_...
# ANTHROPIC_ENVIRONMENT_ID=env_...
# Explicit mock/alternate AG-UI endpoint; bypasses Anthropic and Intelligence:
# AGENT_URL=http://127.0.0.1:4010
